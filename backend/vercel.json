{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "regions": ["bom1"],
  "functions": {
    "api/index.ts": {
      "maxDuration": 15,
      "supportsCancellation": true
    }
  },
  "rewrites": [
    {
      "source": "/v1/register",
      "destination": "/api/index?fridayRoute=register"
    },
    {
      "source": "/v1/warm",
      "destination": "/api/index?fridayRoute=warm"
    },
    {
      "source": "/v1/command",
      "destination": "/api/index?fridayRoute=command"
    }
  ]
}

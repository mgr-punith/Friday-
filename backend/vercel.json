{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run verify",
  "ignoreCommand": "node scripts/ignore-build.mjs",
  "outputDirectory": "public",
  "regions": ["bom1"],
  "functions": {
    "api/index.mjs": {
      "maxDuration": 30,
      "supportsCancellation": true
    }
  },
  "rewrites": [
    {
      "source": "/v1/answers/report",
      "destination": "/api/index?fridayRoute=answers/report"
    },
    {
      "source": "/v1/auth/:path*",
      "destination": "/api/index?fridayRoute=auth/:path*"
    },
    {
      "source": "/v1/register",
      "destination": "/api/index?fridayRoute=register"
    },
    {
      "source": "/v1/warm",
      "destination": "/api/index?fridayRoute=warm"
    },
    {
      "source": "/v1/command",
      "destination": "/api/index?fridayRoute=command"
    }
  ]
}

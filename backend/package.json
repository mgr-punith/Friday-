{
  "name": "friday-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Vercel backend for Friday voice commands with an AWS Lambda fallback",
  "type": "commonjs",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "node build.mjs",
    "build:test": "tsc -p tsconfig.test.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "npm run build:test && node --test build-test/test/*.test.js scripts/*.test.mjs",
    "check:vercel": "node scripts/check-vercel-config.mjs",
    "check:vercel-entry": "node scripts/check-vercel-entry.mjs",
    "verify": "npm run typecheck && npm test && npm run check:vercel && npm run build && npm run check:vercel-entry",
    "eval": "npm run build:test && node --env-file-if-exists=.env build-test/eval/run.js",
    "eval:audio": "npm run build:test && node --env-file-if-exists=.env build-test/eval/run.js --audio-manifest",
    "vercel:build": "npm run typecheck"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1170.0",
    "@aws-sdk/client-ssm": "3.1170.0",
    "@upstash/redis": "1.41.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}

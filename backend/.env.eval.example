# Copy to .env only while running local model evaluations. Never commit real values.
EVAL_PROVIDER=gemini
EVAL_AUDIO_FORMAT=wav
EVAL_DELAY_MS=5000
EVAL_LIMIT=0
EVAL_OFFSET=0

GEMINI_API_KEY=replace-with-a-development-key
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_THINKING_LEVEL=MINIMAL
GEMINI_TIMEOUT_MS=10000

# Groq evaluations remain separate from deployment and use EVAL_PROVIDER=groq.
GROQ_API_KEY=replace-with-a-development-key
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
GROQ_ACTION_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_MS=10000

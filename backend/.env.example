# Copy to .env for local backend work. Never commit real values.
GOOGLE_WEB_CLIENT_ID=replace-with-web-client-id.apps.googleusercontent.com
# Browser fallback only; configure both together after registering the exact callback.
# GOOGLE_WEB_CLIENT_SECRET=replace-with-google-oauth-client-secret
# GOOGLE_OAUTH_REDIRECT_URI=https://your-backend.example/v1/auth/google/callback
AI_PROVIDER=groq
GROQ_API_KEY=replace-with-a-development-key
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
GROQ_ACTION_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_MS=10000
GROQ_MAX_COMPLETION_TOKENS=512
# Enable after deploying the answer routes and reviewing provider search billing/retention.
ANSWERS_ENABLED=false
GROQ_ANSWER_TIMEOUT_MS=18000
ANSWER_PER_ACCOUNT_MINUTE=3
ANSWER_PER_ACCOUNT_DAILY=20
ANSWER_GLOBAL_DAILY=1000
JWT_SIGNING_KEY=replace-with-at-least-32-random-characters
UPSTASH_REDIS_REST_URL=https://replace-with-your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-your-upstash-rest-token
# Optional Gemini rollback: set AI_PROVIDER=gemini and configure these values.
# GEMINI_API_KEY=replace-with-a-development-key
# GEMINI_MODEL=gemini-3.1-flash-lite
# GEMINI_THINKING_LEVEL=MINIMAL
# GEMINI_TIMEOUT_MS=10000
